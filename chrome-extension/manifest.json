{
  "manifest_version": 3,
  "name": "DHCP Mission Control",
  "version": "1.0.1",
  "description": "Open the exact DHCP Mission Control production UI from Chrome, with local offline tools kept in the extension package.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Open DHCP Mission Control",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "open-mission-control": {
      "suggested_key": {
        "default": "Ctrl+Shift+D",
        "mac": "Command+Shift+D"
      },
      "description": "Open the production DHCP Mission Control UI"
    }
  }
}
